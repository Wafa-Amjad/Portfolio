# ==========================================
# Frontend Environment Configuration
# ==========================================

# Backend API Server URL
# - In local development: Leave blank or set to http://localhost:5000 (Vite proxy handles empty base URLs)
# - In production (Render / Vercel): Set to your Render backend URL (e.g. https://your-backend.onrender.com)
VITE_API_BASE_URL=

# Supabase Credentials (Optional: if frontend connects directly to Supabase storage / auth)
# VITE_SUPABASE_URL=https://your-project-id.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anonymous-key

# Optional: Non-SMTP Direct HTTP REST API Fallback (https://web3forms.com)
# VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key

